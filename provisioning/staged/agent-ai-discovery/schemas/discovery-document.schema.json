{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PCakes303/agent-ai-discovery/blob/main/schemas/discovery-document.schema.json",
  "title": "MrCakes931 Discovery Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "discovery_version",
    "publisher",
    "generated_at",
    "resources"
  ],
  "properties": {
    "discovery_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "manifest_uri"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "manifest_uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/@\\s?#]+(?:/[^#\\s]*)?(?:\\?[^#\\s]*)?$"
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "name",
          "manifest_uri",
          "manifest_version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
          },
          "kind": {
            "enum": [
              "agent",
              "tool",
              "service",
              "repository",
              "dataset",
              "schema"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "summary": {
            "type": "string",
            "maxLength": 2000
          },
          "manifest_uri": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[^/@\\s?#]+(?:/[^#\\s]*)?(?:\\?[^#\\s]*)?$"
          },
          "manifest_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "capabilities": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "tags": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
          }
        }
      },
      "maxItems": 512
    }
  }
}
