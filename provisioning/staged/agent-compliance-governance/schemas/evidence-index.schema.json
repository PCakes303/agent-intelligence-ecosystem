{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mrcakes931.dev/compliance/evidence-index/1.0.0",
  "title": "Compliance Evidence Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index_version",
    "records"
  ],
  "properties": {
    "index_version": {
      "const": "1.0"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "control_ids",
          "system_id",
          "artifact_type",
          "description",
          "collected_at",
          "source_uri",
          "sha256",
          "retention_policy",
          "access_class",
          "integrity_status",
          "reviewer"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          },
          "control_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "maxItems": 16,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2,6}-[0-9]{3}$"
            }
          },
          "system_id": {
            "type": "string",
            "minLength": 2,
            "maxLength": 128
          },
          "artifact_type": {
            "enum": [
              "policy",
              "assessment",
              "test_result",
              "audit_record",
              "training_record",
              "notice",
              "data_map",
              "contract",
              "other"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000
          },
          "collected_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_uri": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "retention_policy": {
            "type": "string",
            "minLength": 3,
            "maxLength": 256
          },
          "access_class": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          },
          "integrity_status": {
            "enum": [
              "pending",
              "verified",
              "failed"
            ]
          },
          "reviewer": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          }
        }
      }
    }
  }
}
