{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mrcakes931.dev/compliance/control-catalog/1.0.0",
  "title": "Compliance Control Catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_version",
    "controls"
  ],
  "properties": {
    "catalog_version": {
      "const": "1.0"
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "family",
          "objective",
          "applicability",
          "implementation_status",
          "owner_role",
          "linked_legal_records",
          "evidence_expectations",
          "review_interval_days"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]{2,6}-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 5,
            "maxLength": 160
          },
          "family": {
            "enum": [
              "governance",
              "privacy",
              "ai-risk",
              "transparency",
              "security",
              "evidence",
              "monitoring"
            ]
          },
          "objective": {
            "type": "string",
            "minLength": 20,
            "maxLength": 1000
          },
          "applicability": {
            "enum": [
              "universal-governance",
              "conditional-by-law",
              "conditional-by-use-case",
              "voluntary-framework"
            ]
          },
          "implementation_status": {
            "enum": [
              "proposed",
              "designed",
              "implemented",
              "tested",
              "evidenced"
            ]
          },
          "owner_role": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128
          },
          "linked_legal_records": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 16,
            "items": {
              "type": "string"
            }
          },
          "evidence_expectations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 256
            }
          },
          "review_interval_days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          }
        }
      }
    }
  }
}
