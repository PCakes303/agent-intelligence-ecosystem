    {
      "id": "foundation",
      "constraint": "*",
      "kind": "contract"
    },
    {
      "id": "identity-trust",
      "constraint": "*",
      "kind": "contract"
    },
    {
      "id": "policy-engine",
      "constraint": "*",
      "kind": "contract"
    },
    {
      "id": "audit-provenance",
      "constraint": "*",
      "kind": "contract"
    },
    {
      "id": "secure-supply-chain",
      "constraint": "*",
      "kind": "contract"
    }
