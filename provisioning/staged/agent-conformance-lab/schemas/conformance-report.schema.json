{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mrcakes931.dev/conformance/report/1.0.0",
  "title": "Conformance Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "suite_id",
    "subject_repository",
    "subject_commit",
    "generated_at",
    "overall_status",
    "checks",
    "limitations",
    "report_sha256"
  ],
  "properties": {
    "report_version": {
      "const": "1.0"
    },
    "suite_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "subject_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "subject_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "overall_status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "status",
          "description",
          "evidence_refs",
          "limitations"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 5,
            "maxLength": 512
          },
          "evidence_refs": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 256
            }
          },
          "limitations": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 512
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 512
      }
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
