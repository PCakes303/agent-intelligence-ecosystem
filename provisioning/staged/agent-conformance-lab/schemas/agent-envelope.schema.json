{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mrcakes931.dev/aix/envelope/1.0.0",
  "title": "Synthetic AIX Message Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "message_id",
    "sender_id",
    "recipient_id",
    "message_type",
    "created_at",
    "expires_at",
    "correlation_id",
    "payload_sha256",
    "ttl_seconds",
    "auth_ref",
    "signature_ref",
    "scope"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "sender_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "recipient_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "message_type": {
      "enum": [
        "request",
        "response",
        "event",
        "heartbeat",
        "stop"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "auth_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "signature_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "scope": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    }
  }
}
