{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PCakes303/agent-capability-registry/blob/main/schemas/capability.schema.json",
  "title": "Capability declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["capability_id", "agent_id", "description", "version", "attributes"],
  "properties": {
    "capability_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "agent_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "description": {"type": "string", "minLength": 1, "maxLength": 1024},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "attributes": {"type": "object", "maxProperties": 32, "additionalProperties": {"type": "string", "maxLength": 256}}
  }
}