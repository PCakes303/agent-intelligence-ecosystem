{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PCakes303/agent-capability-registry/blob/main/schemas/requirement.schema.json",
  "title": "Capability requirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_id",
    "attributes"
  ],
  "properties": {
    "capability_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "attributes": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 256
      }
    }
  }
}
