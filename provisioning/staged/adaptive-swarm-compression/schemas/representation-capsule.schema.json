{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PCakes303/adaptive-swarm-compression/blob/main/schemas/representation-capsule.schema.json",
  "title": "Adaptive Swarm Compression Representation Capsule",
  "description": "Proposed metadata contract for a derived representation. A valid document is not proof that its claims or dependencies are trustworthy.",
  "type": "object",
  "required": ["capsule_version", "object_id", "representation_id", "representation_type", "guarantee", "pipeline", "integrity"],
  "properties": {
    "capsule_version": {"type": "string"},
    "object_id": {"type": "string", "minLength": 1},
    "representation_id": {"type": "string", "minLength": 1},
    "representation_type": {"type": "string", "minLength": 1},
    "source_digest": {"type": "object", "required": ["algorithm", "value"], "properties": {"algorithm": {"type": "string"}, "value": {"type": "string"}}, "additionalProperties": false},
    "guarantee": {"enum": ["exact", "bounded-loss", "approximate", "semantic"]},
    "pipeline": {"type": "array", "items": {"type": "object", "required": ["codec", "version"], "properties": {"codec": {"type": "string"}, "version": {"type": "string"}, "parameters": {"type": "object"}}, "additionalProperties": false}},
    "dependencies": {"type": "array", "items": {"type": "object", "required": ["type", "id", "version"], "properties": {"type": {"type": "string"}, "id": {"type": "string"}, "version": {"type": "string"}, "digest": {"type": "string"}}, "additionalProperties": false}},
    "reconstruction": {"type": "object", "properties": {"available": {"type": "boolean"}, "requirements": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "operations": {"type": "array", "items": {"type": "string"}},
    "integrity": {"type": "object", "required": ["algorithm", "value"], "properties": {"algorithm": {"type": "string"}, "value": {"type": "string"}}, "additionalProperties": false},
    "provenance": {"type": "array", "items": {"type": "object"}},
    "authorization": {"type": "object", "description": "Policy reference only; never embed secrets."}
  },
  "additionalProperties": false
}
