{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrcakes931.github.io/agent-intelligence-ecosystem/schemas/foundation-requirement.schema.json",
  "title": "Foundation Security Requirement Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "status",
    "normative_language",
    "requirements"
  ],
  "properties": {
    "contract_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]+$"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "status": {
      "enum": [
        "proposed",
        "experimental",
        "approved",
        "deprecated"
      ]
    },
    "normative_language": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "MUST",
          "MUST NOT",
          "SHOULD",
          "SHOULD NOT",
          "MAY"
        ]
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "domain",
        "priority",
        "statement",
        "verification",
        "owner",
        "depends_on"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FND-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "domain": {
          "enum": [
            "identity",
            "authorization",
            "data-integrity",
            "resource-description",
            "audit",
            "supply-chain",
            "resilience"
          ]
        },
        "priority": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 20
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "unit-test",
              "contract-test",
              "integration-test",
              "security-test",
              "security-review",
              "documentation-review",
              "schema-test",
              "fuzz-test",
              "tamper-test",
              "release-test",
              "provenance-verification",
              "secret-scan",
              "repository-review",
              "failure-injection"
            ]
          }
        },
        "owner": {
          "enum": [
            "agent-foundation-spec",
            "agent-resource-manifest",
            "agent-schema-registry",
            "agent-identity-trust",
            "agent-secure-supply-chain",
            "agent-policy-engine",
            "agent-audit-provenance"
          ]
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^FND-[0-9]{3}$"
          }
        }
      }
    }
  }
}
