{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PCakes303/agent-intelligence-ecosystem/blob/main/schemas/repository-registry.schema.json",
  "title": "MrCakes931 Ecosystem Repository Registry",
  "type": "object",
  "required": [
    "registry_version",
    "portfolio",
    "github_owner",
    "public_identity",
    "counts",
    "repositories"
  ],
  "properties": {
    "registry_version": {
      "type": "string"
    },
    "portfolio": {
      "type": "string"
    },
    "github_owner": {
      "type": "string"
    },
    "public_identity": {
      "type": "string"
    },
    "counts": {
      "type": "object",
      "required": [
        "total",
        "public",
        "private"
      ],
      "properties": {
        "total": {
          "const": 32
        },
        "public": {
          "const": 31
        },
        "private": {
          "const": 1
        }
      },
      "additionalProperties": false
    },
    "status_policy": {
      "type": "string"
    },
    "repositories": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "visibility",
          "layer",
          "status",
          "role",
          "dependencies"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "visibility": {
            "enum": [
              "public",
              "private"
            ]
          },
          "layer": {
            "type": "string"
          },
          "status": {
            "enum": [
              "planned",
              "research",
              "scaffolding",
              "experimental",
              "alpha",
              "beta",
              "stable",
              "maintenance",
              "deprecated",
              "archived"
            ]
          },
          "role": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "public_export": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "$schema": {
      "type": "string",
      "default": "../schemas/repository-registry.schema.json"
    }
  },
  "additionalProperties": false
}
